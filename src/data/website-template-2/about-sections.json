adding: 72px 30px; } #about-c4 .sclad-about-principles-inner { gap: 40px; } #about-c4 .sclad-about-principles-copy { position: static; } #about-c4 .sclad-about-principles-copy h2 { font-size: 34px; } } @media (max-width: 768px) { #about-c4.sclad-about-principles { padding: 55px 20px; } #about-c4 .sclad-about-principles-inner { display: flex; flex-direction: column; align-items: stretch; gap: 32px; } #about-c4 .sclad-about-principles-copy, #about-c4 .sclad-about-principles-list { width: 100%; max-width: 100%; } #about-c4 .sclad-about-principles-copy h2 { font-size: 29px; line-height: 1.18; } #about-c4 .sclad-about-principles-copy > p { font-size: 15px; line-height: 1.75; } #about-c4 .sclad-about-principles-num { flex-basis: 48px; font-size: 24px; } } @media (max-width: 420px) { #about-c4.sclad-about-principles { padding-left: 16px; padding-right: 16px; } #about-c4 .sclad-about-principles-copy h2 { font-size: 26px; } #about-c4 .sclad-about-principles-row { gap: 12px; } } #about-c4.sclad-about-principles { background: var(--sclad-bg, #fff); color: var(--sclad-text, #222); font-family: var(--sclad-font, \"Segoe UI\", Helvetica, Arial, sans-serif); } #about-c4 .sclad-about-principles-label { color: var(--sclad-secondary, #6d675f); } #about-c4 .sclad-about-principles-label::before { background: var(--sclad-primary, #111); } #about-c4 .sclad-about-principles-copy h2, #about-c4 .sclad-about-principles-num, #about-c4 .sclad-about-principles-row h3 { color: var(--sclad-primary, #111); } #about-c4 .sclad-about-principles-copy h2, #about-c4 .sclad-about-principles-num { font-family: var(--sclad-heading, Georgia, \"Times New Roman\", serif); } #about-c4 .sclad-about-principles-copy > p, #about-c4 .sclad-about-principles-row p { color: var(--sclad-muted, #555); } #about-c4 .sclad-about-principles-list, #about-c4 .sclad-about-principles-row { border-color: var(--sclad-line, #e6e1d8); }</style><section id=\"about-c4\" class=\"sclad-r sclad-r-pad sclad-about-principles\"> <div class=\"sclad-stack sclad-about-principles-inner\"> <div class=\"sclad-about-principles-copy\"> <p class=\"sclad-about-principles-label\">What Guides Us</p> <h2>Three things we refuse to hurry</h2> <p>Scholarship, character, and community. Everything else in the school is arranged around these.</p> </div> <div class=\"sclad-about-principles-list\"> <div class=\"sclad-about-principles-row\"> <div class=\"sclad-about-principles-num\">01</div> <div> <h3>Scholarship</h3> <p>Lessons are prepared with care, marked with honesty, and taught so a student can explain the work, not only repeat it.</p> </div> </div> <div class=\"sclad-about-principles-row\"> <div class=\"sclad-about-principles-num\">02</div> <div> <h3>Character</h3> <p>Courtesy, courage, and self-command are practised in the corridor as much as in the classroom.</p> </div> </div> <div class=\"sclad-about-principles-row\"> <div class=\"sclad-about-principles-num\">03</div> <div> <h3>Community</h3> <p>Teachers, families, and students share one standard. No child is left as a stranger in their own school.</p> </div> </div> </div> </div> </section>"
