: 800; letter-spacing: -0.035em; } #about-2 .sclad-about-two-copy p { margin: 0 0 28px; color: var(--sclad-muted, #555555); font-size: 16px; line-height: 1.8; max-width: 520px; } #about-2 .sclad-about-two-btn { display: inline-flex; align-items: center; justify-content: center; gap: 12px; padding: 13px 22px; background: var(--sclad-primary, #111111); color: var(--sclad-on-primary, #ffffff); text-decoration: none; font-size: 14px; font-weight: 700; border-radius: 6px; transition: all 0.25s ease; } #about-2 .sclad-about-two-btn::after { content: \"→\"; font-size: 17px; line-height: 1; transition: transform 0.25s ease; } #about-2 .sclad-about-two-btn:hover { background: var(--sclad-primary, #000000); color: var(--sclad-on-primary, #ffffff); transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16); } #about-2 .sclad-about-two-btn:hover::after { transform: translateX(4px); } @media (max-width: 900px) { #about-2.sclad-about-two { padding: 70px 30px; } #about-2 .sclad-about-two-inner { gap: 45px; } #about-2 .sclad-about-two-copy h2 { font-size: 33px; } } @media (max-width: 768px) { #about-2.sclad-about-two { padding: 55px 20px; } #about-2 .sclad-about-two-inner { display: flex; flex-direction: column; align-items: stretch; gap: 38px; } #about-2 .sclad-about-two-media, #about-2 .sclad-about-two-copy { width: 100%; max-width: 100%; } #about-2 .sclad-about-two-media::before { width: 80px; height: 80px; right: -8px; top: -8px; border-radius: 18px; } #about-2 .sclad-about-two-media::after { width: 50px; height: 50px; left: -8px; bottom: -8px; border-radius: 12px; } #about-2 .sclad-about-two-media img { border-radius: 12px; } #about-2 .sclad-about-two-copy h2 { font-size: 29px; line-height: 1.2; } #about-2 .sclad-about-two-copy p { font-size: 15px; line-height: 1.75; max-width: none; } } @media (max-width: 420px) { #about-2.sclad-about-two { padding-left: 16px; padding-right: 16px; } #about-2 .sclad-about-two-copy h2 { font-size: 26px; } }</style><section id=\"ab