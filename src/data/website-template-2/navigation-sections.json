14px; font-weight: 600; line-height: 1; } #nav-n5 .apply { display: inline-flex; align-items: center; justify-content: center; padding: 10px 16px; border-radius: 8px; font-size: 13px; font-weight: 700; letter-spacing: 0; text-transform: none; line-height: 1; white-space: nowrap; } @media (min-width: 1100px) { #nav-n5 .pages a, #nav-n5 .login { font-size: 15px; } } #nav-n5.sclad-nav { background: var(--sclad-bg, #fff); border-bottom: 3px solid var(--sclad-primary, #161616); } #nav-n5 .inner { max-width: 1160px; margin: 0 auto; min-height: 82px; padding: 0 28px; display: flex; align-items: center; gap: 20px; } #nav-n5 .logo img { border-radius: 2px; } #nav-n5 .brand { margin-right: auto; font-size: 22px; } #nav-n5 .links { display: flex; align-items: center; gap: 18px; } #nav-n5 .pages { gap: 16px; } #nav-n5 .pages a { font-family: var(--sclad-heading, Georgia, serif); font-size: 16px; font-weight: 500; color: var(--sclad-text, #333); } #nav-n5 .login { padding-left: 16px; border-left: 1px solid var(--sclad-line, #e7e1d8); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--sclad-primary, #111); } #nav-n5 .apply { border-radius: 0; padding: 12px 16px; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; } @media (max-width: 900px) { #nav-n5 .pages a { font-size: 14px; } #nav-n5 .pages { gap: 12px; } } @media (max-width: 720px) { #nav-n5 .inner { display: flex !important; flex-direction: row !important; flex-wrap: wrap !important; align-items: center !important; min-height: 64px !important; padding: 10px 16px !important; gap: 10px !important; border-radius: 0 !important; box-shadow: none !important; } #nav-n5 .brand { margin: 0 !important; padding: 0 !important; border: 0 !important; justify-content: flex-start !important; font-size: 18px !important; } #nav-n5 .burger { display: flex; } #nav-n5 .links, #nav-n5 .pages { display: none; width: 100%; flex-direction: column; align-items: stretch; gap: 0 !important; margin: 0; padding: 4px 0 8px; border: 0; background: transparent; } #nav-n5 .toggle:checked ~ .links { display: flex; } #nav-n5 .toggle:checked ~ .links .pages { display: flex; } #nav-n5 .pages a, #nav-n5 .login { padding: 14px 2px !important; border: 0 !important; border-radius: 0 !important; font-size: 15px !important; } #nav-n5 .pages a + a::before { display: none; } #nav-n5 .apply { margin-top: 8px; align-self: flex-start; } }</style><nav id=\"nav-n5\" class=\"sclad-nav\"><div class=\"inner\"><a class=\"brand sclad-nav-brand\" href=\"/\"><span class=\"logo\" data-sclad-logo></span><span data-sclad-brand>School Name</span></a><input id=\"nav-n5-t\" class=\"toggle\" type=\"checkbox\"><label for=\"nav-n5-t\" class=\"burger\" aria-label=\"Open menu\"><span></span></label><div class=\"links\"><div class=\"pages sclad-nav-pages\" data-sclad-pages></div><a class=\"login\" href=\"#\" data-sclad-login>Login</a><a class=\"apply sclad-nav-apply\" href=\"#\" data-sclad-apply>Apply</a></div></div></nav>"
