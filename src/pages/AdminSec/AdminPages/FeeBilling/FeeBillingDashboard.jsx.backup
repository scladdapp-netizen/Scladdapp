            padding: "3px 8px",
            borderRadius: "12px",
            fontSize: "11px",
            fontWeight: "600",
            backgroundColor: value ? "#fef3c7" : "#e0e7ff",
            color: value ? "#92400e" : "#3730a3",
          }}
        >
          {value ? "Mandatory" : "Optional"}
        </span>
      ),
    },
    {
      label: "Status",
      accessor: "status",
      render: (value) => (
        <span
          className={`status-badge ${value.toLowerCase()}`}
          style={{
            padding: "4px 8px",
            borderRadius: "12px",
            fontSize: "11px",
            fontWeight: "600",
            backgroundColor: value === "Active" ? "#dcfce7" : "#fecaca",
            color: value === "Active" ? "#166534" : "#991b1b",
          }}
        >
          {value}
        </span>
      ),
    },
    {
      label: "Collection Rate",
      accessor: "collectionRate",
      render: (v, row) => {
